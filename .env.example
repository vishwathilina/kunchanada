# Neon Postgres connection string (PostGIS is enabled by the first migration).
# For local development you can use the docker-compose PostGIS instance instead:
# DATABASE_URL=postgres://kunchanada:kunchanada@localhost:5432/kunchanada
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/kunchanada?sslmode=require

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# UploadThing (https://uploadthing.com/dashboard -> API Keys)
UPLOADTHING_TOKEN=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# ISO currency code used for donations
NEXT_PUBLIC_CURRENCY=usd

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minutes without a vet check-in before the emergency button unlocks
ESCALATION_MINUTES=30
